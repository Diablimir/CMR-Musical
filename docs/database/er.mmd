    proveedores ||--o{ venue_proveedores : "proveedor_id (CASCADE)"
    artistas {
        varchar id PK
        varchar nombre_artistico
        varchar nombre_legal
        tinyint etapa_id FK
        varchar isrc_default
        varchar iswc_default
        varchar sociedad_gestion
        varchar rfc
        varchar ciudad
        varchar estado
        varchar pais
        text foto
    }
    artista_contactos {
        varchar artista_id PK,FK
        varchar contacto_id PK,FK
        smallint_unsigned rol_id PK,FK
        tinyint es_principal
    }
    artista_generos {
        varchar artista_id PK,FK
        smallint_unsigned genero_id PK,FK
        tinyint es_principal
        tinyint_unsigned orden
    }
    cat_etapas_desarrollo {
        tinyint id PK
        varchar nombre
    }
    cat_generos {
        smallint_unsigned id PK
        varchar nombre
        varchar descripcion
    }
    cat_monedas {
        char codigo PK
        varchar nombre
    }
    cat_roles_contacto {
        smallint_unsigned id PK
        varchar nombre
    }
    contactos {
        varchar id PK
        varchar nombre
        varchar apellidos
    }
    contacto_correos {
        bigint_unsigned id PK
        varchar contacto_id FK
        varchar correo
        varchar etiqueta
        tinyint es_principal
    }
    contacto_telefonos {
        bigint_unsigned id PK
        varchar contacto_id FK
        varchar telefono
        varchar etiqueta
        tinyint es_principal
    }
    contratos {
        varchar id PK
        varchar titulo
        varchar artista_id FK
        varchar venue_id FK
        varchar tour_id FK
        varchar evento_id FK
        varchar tipo
        varchar estado
        varchar nombre_archivo
        text notas
        datetime fecha_subida
        bigint tamano_bytes
    }
    eventos {
        varchar id PK
        varchar nombre
        varchar venue_id FK
        varchar tour_id FK
        date fecha
        varchar estado
        int capacidad
        int asistencia
        decimal precio_boleto
        decimal ingreso_total
        decimal gastos_totales
        decimal utilidad
    }
    evento_artistas {
        bigint_unsigned id PK
        varchar evento_id FK
        varchar artista_id FK
        varchar rol
        tinyint es_principal
        smallint_unsigned orden_presentacion
        time hora_inicio
        time hora_fin
        decimal honorarios
        char moneda FK
        varchar estado_confirmacion
    }
    proveedores {
        varchar id PK
        varchar nombre
        varchar categoria
        decimal rating
        decimal costo_por_show
        text notas
    }
    proveedor_contactos {
        varchar proveedor_id PK,FK
        varchar contacto_id PK,FK
        smallint_unsigned rol_id PK,FK
        tinyint es_principal
    }
    proyectos_grabacion {
        varchar id PK
        varchar titulo
        varchar artista_id FK
        varchar estado
        date fecha_lanzamiento
        varchar estudio
        varchar productor
    }
    schema_meta {
        int id PK
    }
    tours {
        varchar id PK
        varchar nombre
        date fecha_inicio
        date fecha_fin
        varchar status
    }
    tour_artistas {
        varchar tour_id PK,FK
        varchar artista_id PK,FK
        tinyint es_principal
    }
    venues {
        varchar id PK
        varchar nombre
        text direccion
        varchar ciudad
        varchar estado
        varchar pais
        varchar codigo_postal
        decimal latitud
        decimal longitud
        decimal rating
        smallint score_rentabilidad
        smallint score_respuesta
        smallint score_puntualidad_pago
        smallint score_negociacion
        smallint score_produccion
        smallint score_hospitalidad
    }
    venue_contactos {
        varchar venue_id PK,FK
        varchar contacto_id PK,FK
        smallint_unsigned rol_id PK,FK
        tinyint es_principal
    }
    venue_proveedores {
        varchar venue_id PK,FK
        varchar proveedor_id PK,FK
    }
