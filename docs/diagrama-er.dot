digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.7, ranksep=1.0, pad=0.5, fontname="Helvetica", bgcolor="white", label=<<B>FLAMO CRM · Diagrama entidad-relación</B><BR/><FONT POINT-SIZE="11" COLOR="#64748B">Esquema v3 · solo columnas clave · punteada = al borrar el padre queda en NULL · pata de gallo = muchos</FONT>>, labelloc=t, fontsize=18];
