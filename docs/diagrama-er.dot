    <TR><TD ALIGN="LEFT" PORT="id" WIDTH="26"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre" WIDTH="26"></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inicio" WIDTH="26"></TD><TD ALIGN="LEFT">fecha_inicio</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_fin" WIDTH="26"></TD><TD ALIGN="LEFT">fecha_fin</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status" WIDTH="26"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(50)</FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#94A3B8" POINT-SIZE="9"><I>+ 4 columnas más</I></FONT></TD></TR></TABLE>>];
  tour_artistas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#E84A2E"><FONT COLOR="white"><B>tour_artistas</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="tour_id" WIDTH="26"><B>PK</B> <B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT"><B>tour_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="artista_id" WIDTH="26"><B>PK</B> <B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT"><B>artista_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="es_principal" WIDTH="26"></TD><TD ALIGN="LEFT">es_principal</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">TINYINT(1)</FONT></TD></TR></TABLE>>];
  venues [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#0A2538"><FONT COLOR="white"><B>venues</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id" WIDTH="26"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre" WIDTH="26"></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="direccion" WIDTH="26"></TD><TD ALIGN="LEFT">direccion</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ciudad" WIDTH="26"></TD><TD ALIGN="LEFT">ciudad</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado" WIDTH="26"></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(150)</FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#94A3B8" POINT-SIZE="9"><I>+ 16 columnas más</I></FONT></TD></TR></TABLE>>];
  venue_contactos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#0A2538"><FONT COLOR="white"><B>venue_contactos</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="venue_id" WIDTH="26"><B>PK</B> <B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT"><B>venue_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="contacto_id" WIDTH="26"><B>PK</B> <B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT"><B>contacto_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rol_id" WIDTH="26"><B>PK</B> <B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT"><B>rol_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">SMALLINT(5) UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="es_principal" WIDTH="26"></TD><TD ALIGN="LEFT">es_principal</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">TINYINT(1)</FONT></TD></TR></TABLE>>];
  venue_proveedores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#0A2538"><FONT COLOR="white"><B>venue_proveedores</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="venue_id" WIDTH="26"><B>PK</B> <B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT"><B>venue_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="proveedor_id" WIDTH="26"><B>PK</B> <B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT"><B>proveedor_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR></TABLE>>];
