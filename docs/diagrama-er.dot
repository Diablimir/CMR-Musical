digraph ER {
  graph [rankdir=TB, splines=true, nodesep=0.9, ranksep=1.1, pad=0.5, fontname="Helvetica", bgcolor="white", label=<<B>FLAMO CRM · Diagrama entidad-relación</B><BR/><FONT POINT-SIZE="11" COLOR="#64748B">Solo columnas clave · línea punteada = al borrar el padre queda en NULL · pata de gallo = muchos</FONT>>, labelloc=t, fontsize=18];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, fontcolor="#475569", color="#64748B", arrowsize=0.9];
  cat_etapas_desarrollo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#7C8794"><FONT COLOR="white"><B>cat_etapas_desarrollo</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id" WIDTH="26"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre" WIDTH="26"></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(50)</FONT></TD></TR></TABLE>>];
  artistas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#E84A2E"><FONT COLOR="white"><B>artistas</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id" WIDTH="26"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_artistico" WIDTH="26"></TD><TD ALIGN="LEFT">nombre_artistico</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_legal" WIDTH="26"></TD><TD ALIGN="LEFT">nombre_legal</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="genero" WIDTH="26"></TD><TD ALIGN="LEFT">genero</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="etapa_id" WIDTH="26"><B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT">etapa_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="manager" WIDTH="26"></TD><TD ALIGN="LEFT">manager</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#94A3B8" POINT-SIZE="9"><I>+ 13 columnas más</I></FONT></TD></TR></TABLE>>];
  venues [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#0A2538"><FONT COLOR="white"><B>venues</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id" WIDTH="26"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre" WIDTH="26"></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="direccion" WIDTH="26"></TD><TD ALIGN="LEFT">direccion</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ciudad" WIDTH="26"></TD><TD ALIGN="LEFT">ciudad</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado" WIDTH="26"></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="contacto_principal_id" WIDTH="26"><B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT">contacto_principal_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#94A3B8" POINT-SIZE="9"><I>+ 15 columnas más</I></FONT></TD></TR></TABLE>>];
  contactos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#0A2538"><FONT COLOR="white"><B>contactos</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id" WIDTH="26"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="venue_id" WIDTH="26"><B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT">venue_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre" WIDTH="26"></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="correo" WIDTH="26"></TD><TD ALIGN="LEFT">correo</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="telefono" WIDTH="26"></TD><TD ALIGN="LEFT">telefono</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rol" WIDTH="26"></TD><TD ALIGN="LEFT">rol</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(150)</FONT></TD></TR></TABLE>>];
  proveedores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#0A2538"><FONT COLOR="white"><B>proveedores</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id" WIDTH="26"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre" WIDTH="26"></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="categoria" WIDTH="26"></TD><TD ALIGN="LEFT">categoria</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="contacto" WIDTH="26"></TD><TD ALIGN="LEFT">contacto</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="telefono" WIDTH="26"></TD><TD ALIGN="LEFT">telefono</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(60)</FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#94A3B8" POINT-SIZE="9"><I>+ 5 columnas más</I></FONT></TD></TR></TABLE>>];
  venue_proveedores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#0A2538"><FONT COLOR="white"><B>venue_proveedores</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="venue_id" WIDTH="26"><B>PK</B> <B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT"><B>venue_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="proveedor_id" WIDTH="26"><B>PK</B> <B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT"><B>proveedor_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR></TABLE>>];
  tours [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#E84A2E"><FONT COLOR="white"><B>tours</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id" WIDTH="26"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="artista_id" WIDTH="26"><B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT">artista_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre" WIDTH="26"></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inicio" WIDTH="26"></TD><TD ALIGN="LEFT">fecha_inicio</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_fin" WIDTH="26"></TD><TD ALIGN="LEFT">fecha_fin</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status" WIDTH="26"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(50)</FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#94A3B8" POINT-SIZE="9"><I>+ 3 columnas más</I></FONT></TD></TR></TABLE>>];
  eventos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#B7791F"><FONT COLOR="white"><B>eventos</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id" WIDTH="26"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre" WIDTH="26"></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="artista_id" WIDTH="26"><B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT">artista_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="venue_id" WIDTH="26"><B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT">venue_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tour_id" WIDTH="26"><B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT">tour_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha" WIDTH="26"></TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado" WIDTH="26"></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="capacidad" WIDTH="26"></TD><TD ALIGN="LEFT">capacidad</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#94A3B8" POINT-SIZE="9"><I>+ 9 columnas más</I></FONT></TD></TR></TABLE>>];
  contratos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#B7791F"><FONT COLOR="white"><B>contratos</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id" WIDTH="26"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="titulo" WIDTH="26"></TD><TD ALIGN="LEFT">titulo</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="artista_id" WIDTH="26"><B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT">artista_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="venue_id" WIDTH="26"><B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT">venue_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tour_id" WIDTH="26"><B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT">tour_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="evento_id" WIDTH="26"><B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT">evento_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo" WIDTH="26"></TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado" WIDTH="26"></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_archivo" WIDTH="26"></TD><TD ALIGN="LEFT">nombre_archivo</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#94A3B8" POINT-SIZE="9"><I>+ 3 columnas más</I></FONT></TD></TR></TABLE>>];
  proyectos_grabacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#CBD5E1" BGCOLOR="white">
    <TR><TD COLSPAN="3" BGCOLOR="#E84A2E"><FONT COLOR="white"><B>proyectos_grabacion</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id" WIDTH="26"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="titulo" WIDTH="26"></TD><TD ALIGN="LEFT">titulo</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="artista_id" WIDTH="26"><B><FONT COLOR="#C05621">FK</FONT></B></TD><TD ALIGN="LEFT">artista_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado" WIDTH="26"></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_lanzamiento" WIDTH="26"></TD><TD ALIGN="LEFT">fecha_lanzamiento</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estudio" WIDTH="26"></TD><TD ALIGN="LEFT">estudio</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#94A3B8" POINT-SIZE="9"><I>+ 3 columnas más</I></FONT></TD></TR></TABLE>>];
  artistas -> cat_etapas_desarrollo [dir=both, arrowtail=crow, arrowhead=tee, style=solid, label="  etapa_id  "];
  venues -> contactos [dir=both, arrowtail=crow, arrowhead=teeodot, style=solid, label="  contacto_principal_id  "];
  contactos -> venues [dir=both, arrowtail=crow, arrowhead=tee, style=solid, label="  venue_id · CASCADE  "];
  venue_proveedores -> venues [dir=both, arrowtail=crow, arrowhead=tee, style=solid, label="  venue_id · CASCADE  "];
  venue_proveedores -> proveedores [dir=both, arrowtail=crow, arrowhead=tee, style=solid, label="  proveedor_id · CASCADE  "];
  tours -> artistas [dir=both, arrowtail=crow, arrowhead=tee, style=solid, label="  artista_id  "];
  eventos -> artistas [dir=both, arrowtail=crow, arrowhead=tee, style=solid, label="  artista_id  "];
  eventos -> venues [dir=both, arrowtail=crow, arrowhead=tee, style=solid, label="  venue_id  "];
  eventos -> tours [dir=both, arrowtail=crow, arrowhead=teeodot, style=dashed, label="  tour_id · SET NULL  "];
  contratos -> artistas [dir=both, arrowtail=crow, arrowhead=teeodot, style=dashed, label="  artista_id · SET NULL  "];
  contratos -> venues [dir=both, arrowtail=crow, arrowhead=teeodot, style=dashed, label="  venue_id · SET NULL  "];
  contratos -> tours [dir=both, arrowtail=crow, arrowhead=teeodot, style=dashed, label="  tour_id · SET NULL  "];
  contratos -> eventos [dir=both, arrowtail=crow, arrowhead=teeodot, style=dashed, label="  evento_id · SET NULL  "];
  proyectos_grabacion -> artistas [dir=both, arrowtail=crow, arrowhead=teeodot, style=dashed, label="  artista_id · SET NULL  "];
}