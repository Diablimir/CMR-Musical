# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: API Key for Google Maps Platform.
# Configured via Settings -> Secrets in AI Studio with this key name.
GOOGLE_MAPS_PLATFORM_KEY=

# APIFY_API_TOKEN: API Token for Apify social media web scrapers.
# Get token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=
